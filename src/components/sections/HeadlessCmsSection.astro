---
/**
 * Figma: TEST/headless-cms-section (2983:14001), Theme=Default
 * (instances 3029:66060 / 3030:20062 / 3030:21236 / 3030:18868 / 3030:17668), lockup
 * TEST/headless-cms-lockup (2982:14064) → src/components/headless/HeadlessLockup.astro.
 *
 * - Background surface/inverse, text text/on-inverse; paragraph at 70% opacity.
 * - ≥768 (Breakpoint=768+): content column max 1160, height test/headless-visual-height;
 *   headline (type/H2) top-left, paragraph (type/Body) bottom-left, lockup centred behind them.
 * - <768 (Breakpoint=<768): headline (type/H1 size in Figma) + paragraph stacked (gap space/2xs),
 *   gap space/md, then the visual strip: runs to the section edges, fixed height
 *   (visual-height 250), anchored to the bottom (section padding-bottom 0).
 * - test/headless-* Sizing variables are scoped custom properties below (--hl-*), one block per
 *   Sizing mode (393 base / 768 / 1152 / 1320+). Display + D size are container-relative (cqi).
 * - The list overflows above/below the content column and is clipped by the section.
 * - MOTION (code only; timing frame "headless-cms-section-animation" 1499:47138 could not be read,
 *   see docs/notes/showcase.md): every 2.4s the list moves up by one item with a CSS transform
 *   (700ms, ease-in-out), the new centre item fades to 100%, the old one to 30%. Infinite loop.
 *   Paused while off-screen or the tab is hidden. prefers-reduced-motion: static (Chatbot centred).
 */
import HeadlessLockup from '../headless/HeadlessLockup.astro';

interface Props {
  headline?: string;
  paragraph?: string;
  label?: string;
  shortLabel?: string;
  items?: string[];
  activeItem?: string;
}
const {
  headline = 'Give your content a long, healthy life [•*•]',
  paragraph = 'Website, chatbot, mobile, a smart fridge? One place for every role to manage content across every output.',
  label = 'Single Source',
  shortLabel = 'Source',
  items = ['Kiosk', 'Watch', 'Alexa', 'Store', 'Chatbot', 'Website', 'App', 'Smart TV', 'Car Widget'],
  activeItem = 'Chatbot',
} = Astro.props;
---
<section class="hl" data-theme="default" data-headless>
  <div class="hl__inner">
    <div class="hl__text">
      <h2 class="hl__headline">{headline}</h2>
      <p class="hl__paragraph t-body">{paragraph}</p>
    </div>
    <p class="visually-hidden">{label} for: {items.join(', ')}.</p>
    <div class="hl__visual">
      <HeadlessLockup label={label} shortLabel={shortLabel} items={items} activeItem={activeItem} />
    </div>
  </div>
</section>

<style>
  /* Sizing collection: test/headless-* (mode 393 = base) */
  .hl {
    --hl-display-size: 9.855cqi;      /* 32.817 @ 333 content width */
    --hl-symbol-size: 7.2cqi;         /* 24.07 */
    --hl-visual-height: 250px;
    --hl-lockup-gap: 19.69px;
    --hl-list-offset: 2.19px;
    --hl-list-gap: 3.64px;
    --hl-lockup-pad-left: 0px;
    --hl-lockup-pad-right: 50.39px;
    --hl-lockup-pad-top: 8.12px;
    --hl-lockup-pad-bottom: 0px;
    --hl-headline-width: 319px;
    --hl-paragraph-width: 281px;
    --hl-section-pad-bottom: 0px;
    --hl-symbol-lift: 1px;
    --hl-show-full-label: none;
    --hl-show-short-label: inline;
    /* motion (not in Figma variables — see header) */
    --hl-move-dur: 700ms;
    --hl-move-ease: cubic-bezier(0.65, 0, 0.35, 1);

    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    padding: var(--section-padding-y) var(--section-padding-x) var(--hl-section-pad-bottom);
    overflow: clip;
  }
  @media (min-width: 768px) {
    .hl {
      --hl-display-size: 7.3cqi;      /* 84.507 @ 1160, 76.62 @ 1032, 48.559 @ 648 */
      --hl-symbol-size: 5.3cqi;       /* 61.97 @ 1160 */
      --hl-visual-height: 369px;
      --hl-lockup-gap: 29.14px;
      --hl-list-offset: 3.23px;
      --hl-list-gap: 5.39px;
      --hl-lockup-pad-left: 14.45px;
      --hl-lockup-pad-right: 0px;
      --hl-lockup-pad-top: 0px;
      --hl-lockup-pad-bottom: 9.46px;
      --hl-headline-width: 281px;
      --hl-paragraph-width: 310px;
      --hl-section-pad-bottom: 51px;
      --hl-symbol-lift: 1.54px;
      --hl-show-full-label: inline;
      --hl-show-short-label: none;
    }
  }
  @media (min-width: 1152px) {
    .hl {
      --hl-visual-height: 571.91px;
      --hl-lockup-gap: 45.97px;
      --hl-list-offset: 5.11px;
      --hl-list-gap: 8.51px;
      --hl-lockup-pad-left: 14.79px;
      --hl-lockup-pad-bottom: 4.59px;
      --hl-headline-width: 361px;
      --hl-paragraph-width: 332px;
      --hl-section-pad-bottom: 84.09px;
      --hl-symbol-lift: 1.68px;
    }
  }
  @media (min-width: 1320px) {
    .hl {
      --hl-visual-height: 632.01px;
      --hl-lockup-gap: 50.7px;
      --hl-list-offset: 5.64px;
      --hl-list-gap: 9.39px;
      --hl-lockup-pad-left: 0px;
      --hl-lockup-pad-right: 1.79px;
      --hl-lockup-pad-bottom: 6.09px;
      --hl-paragraph-width: 345px;
      --hl-section-pad-bottom: 113.99px;
      --hl-symbol-lift: 1.88px;
    }
  }

  .hl__inner {
    position: relative;
    max-width: 1160px;
    margin-inline: auto;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hl__text { display: flex; flex-direction: column; gap: var(--space-2xs); }
  /* <768: Figma uses the Oracle/H1 style for the headline */
  .hl__headline {
    max-width: var(--hl-headline-width);
    font: 500 var(--type-h1)/1 var(--font-sans);
    letter-spacing: -0.04em;
  }
  .hl__paragraph { max-width: var(--hl-paragraph-width); opacity: 0.7; }
  .hl__visual {
    position: relative;
    height: var(--hl-visual-height);
    margin-inline: calc(-1 * var(--section-padding-x));
    overflow: clip;
  }

  @media (min-width: 768px) {
    .hl__inner { height: var(--hl-visual-height); gap: 0; }
    .hl__text { display: contents; }
    .hl__headline,
    .hl__paragraph { position: relative; z-index: 1; }
    /* ≥768: Oracle/H2 */
    .hl__headline { font: 500 var(--type-h2)/1.1 var(--font-sans); letter-spacing: -0.02em; }
    .hl__paragraph { margin-top: auto; }
    .hl__visual {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
      overflow: visible;
    }
  }
</style>

<script>
  const STEP_MS = 2400;

  function initList(section: HTMLElement) {
    const list = section.querySelector<HTMLElement>('[data-hl-list]');
    if (!list) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const count = Number(list.dataset.count);
    const items = Array.from(list.children) as HTMLElement[];
    let i = Number(list.dataset.start);
    let timer: number | undefined;
    let visible = false;

    const apply = (index: number) => {
      list.style.setProperty('--i', String(index));
      items.forEach((el, n) => el.classList.toggle('is-active', n === index));
    };

    const step = () => {
      i += 1;
      apply(i);
      if (i >= count * 2) {
        // reached the third copy: once the move ends, jump back one cycle without animation
        list.addEventListener('transitionend', function snap(e) {
          if (e.target !== list) return;
          list.removeEventListener('transitionend', snap);
          list.classList.add('no-transition');
          i -= count;
          apply(i);
          void list.offsetHeight;
          list.classList.remove('no-transition');
        });
      }
    };

    const play = () => {
      if (timer || !visible || document.hidden) return;
      timer = window.setInterval(step, STEP_MS);
    };
    const stop = () => { clearInterval(timer); timer = undefined; };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? play() : stop();
    }).observe(section);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
  }

  document.querySelectorAll<HTMLElement>('[data-headless]').forEach(initList);
</script>
