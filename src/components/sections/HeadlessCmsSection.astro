---
/**
 * Figma: TEST/headless-cms-section (2983:14001), Theme=Default
 * (instances 3029:66060 / 3030:20062 / 3030:21236 / 3030:18868 / 3030:17668), lockup
 * TEST/headless-cms-lockup (2982:14064) → src/components/headless/HeadlessLockup.astro.
 *
 * - Background surface/inverse, text text/on-inverse; paragraph at 70% opacity.
 * - ≥768 (Breakpoint=768+): content column max 1160, visual height container-driven (below);
 *   headline (type/H2) top-left, paragraph (type/Body) bottom-left, lockup centred behind them.
 * - <768 (Breakpoint=<768): headline (type/H1 size in Figma) + paragraph stacked (gap space/2xs),
 *   gap space/md, then the visual strip: runs to the section edges, fixed height
 *   (75% of the column width = 250 at 393), anchored to the bottom (section padding-bottom 0).
 *   ≥768 bottom padding = section/padding-y.
 * - Headline max width 361 (319 <768), paragraph max width 345 (281 <768) – from the variants.
 * - SIZING IS CONTAINER-DRIVEN. Figma's "Component sizing" collection (headless/*) is a preview aid
 *   only and is deliberately NOT copied here. The one rule: display size = 7.3cqi of the content
 *   column (9.855cqi below 768); the lockup derives everything else from it (HeadlessLockup.astro).
 *   Visual height ≥768 = 0.5137 × column width + 36px (max 632) – a straight-line fit of the Figma frames.
 * - The list overflows above/below the content column and is clipped by the section.
 * - MOTION from headless-cms-section-animation (1499:47138, page "Responsive (source of truth)"):
 *   hold 0.8s, then the list moves up one row with a CSS transform — 416ms, Figma "Slow" spring
 *   (mass 1, stiffness 80, damping 20 → overdamped, approximated with linear() below). The new
 *   centre item fades to 100%, the old one to 30%. Infinite and seamless (no gap, no visible jump).
 *   "D" and the label stay still. Starts in view, pauses off-screen / hidden tab.
 *   prefers-reduced-motion: static Step 1 (Chatbot centred).
 */
import HeadlessLockup from '../headless/HeadlessLockup.astro';

interface Props {
  headline?: string;
  paragraph?: string;
  label?: string;
  shortLabel?: string;
  items?: string[];
  activeItem?: string;
}
const {
  headline = 'Give your content a long, healthy life [•*•]',
  paragraph = 'Website, chatbot, mobile, a smart fridge? One place for every role to manage content across every output.',
  label = 'Single Source',
  shortLabel = 'Source',
  items = ['Kiosk', 'Watch', 'Alexa', 'Store', 'Chatbot', 'Website', 'App', 'Smart TV', 'Car Widget'],
  activeItem = 'Chatbot',
} = Astro.props;
---
<section class="hl" data-theme="default" data-headless>
  <div class="hl__inner">
    <div class="hl__text">
      <h2 class="hl__headline">{headline}</h2>
      <p class="hl__paragraph t-body">{paragraph}</p>
    </div>
    <p class="visually-hidden">{label} for: {items.join(', ')}.</p>
    <div class="hl__visual">
      <HeadlessLockup label={label} shortLabel={shortLabel} items={items} activeItem={activeItem} />
    </div>
  </div>
</section>

<style>
  /* Container-driven sizing (see header). Mobile-first. */
  .hl {
    --hl-display-size: 9.855cqi;  /* of .hl__inner – 32.8px @ 333 */
    /* motion (prototype of headless-cms-section-animation — see header) */
    --hl-move-dur: 416ms;
    --hl-move-ease: linear(0, 0.165 6%, 0.413 12%, 0.612 19%, 0.750 25%, 0.841 31%, 0.899 38%, 0.936 44%, 0.960 50%, 0.975 56%, 0.984 62%, 0.990 69%, 0.994 75%, 0.996 81%, 0.997 88%, 0.998 94%, 1);

    container: hl / inline-size;
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    padding: var(--section-padding-y) var(--section-padding-x) 0;
    overflow: clip;
  }
  @media (min-width: 768px) {
    .hl {
      --hl-display-size: 7.3cqi;  /* 84.7px @ 1160, 75.3 @ 1032, 47.3 @ 648 */
      padding-bottom: var(--section-padding-y);
    }
  }

  .hl__inner {
    position: relative;
    max-width: 1160px;
    margin-inline: auto;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hl__text { display: flex; flex-direction: column; gap: var(--space-2xs); }
  /* <768: Figma uses the Oracle/H1 style for the headline */
  .hl__headline {
    max-width: 319px;
    font: 500 var(--type-h1)/1 var(--font-sans);
    letter-spacing: -0.04em;
  }
  .hl__paragraph { max-width: 281px; opacity: 0.7; }
  .hl__visual {
    position: relative;
    height: min(75cqi, 250px); /* cqi of the section (hl container) */
    margin-inline: calc(-1 * var(--section-padding-x));
    overflow: clip;
  }

  @media (min-width: 768px) {
    .hl__inner { height: min(calc(51.37cqw + 36px), 632px); gap: 0; } /* fits 632 @1160, 566 @1032, 369 @648 */
    .hl__headline { max-width: 361px; }
    .hl__paragraph { max-width: 345px; }
    .hl__text { display: contents; }
    .hl__headline,
    .hl__paragraph { position: relative; z-index: 1; }
    /* ≥768: Oracle/H2 */
    .hl__headline { font: 500 var(--type-h2)/1.1 var(--font-sans); letter-spacing: -0.02em; }
    .hl__paragraph { margin-top: auto; }
    .hl__visual {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
      overflow: visible;
    }
  }
</style>

<script>
  // Figma: AFTER_TIMEOUT 0.8s on each step (counted once the previous move has landed) + 416ms move
  const HOLD_MS = 800;
  const MOVE_MS = 416;
  const STEP_MS = HOLD_MS + MOVE_MS;

  function initList(section: HTMLElement) {
    const list = section.querySelector<HTMLElement>('[data-hl-list]');
    if (!list) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const count = Number(list.dataset.count);
    const items = Array.from(list.children) as HTMLElement[];
    let i = Number(list.dataset.start);
    let timer: number | undefined;
    let visible = false;

    const apply = (index: number) => {
      list.style.setProperty('--i', String(index));
      items.forEach((el, n) => el.classList.toggle('is-active', n === index));
    };

    const step = () => {
      i += 1;
      apply(i);
      if (i >= count * 2) {
        // reached the third copy: once the move ends, jump back one cycle without animation
        list.addEventListener('transitionend', function snap(e) {
          if (e.target !== list) return;
          list.removeEventListener('transitionend', snap);
          list.classList.add('no-transition');
          i -= count;
          apply(i);
          void list.offsetHeight;
          list.classList.remove('no-transition');
        });
      }
    };

    const play = () => {
      if (timer || !visible || document.hidden) return;
      timer = window.setInterval(step, STEP_MS);
    };
    const stop = () => { clearInterval(timer); timer = undefined; };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? play() : stop();
    }).observe(section);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
  }

  document.querySelectorAll<HTMLElement>('[data-headless]').forEach(initList);
</script>
