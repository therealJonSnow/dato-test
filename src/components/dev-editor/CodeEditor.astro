---
/**
 * Figma: code-editor layer of developer-editor-experience-section (3026:11822), e.g. 3026:11476.
 * Static GraphQL query (decorative). Every size is in em so the parent mock-up can scale the
 * whole layer by changing font-size (drawn 12.185px at 1152+ Developer).
 * Focus colours (set by [data-focus] on the section):
 *  - Developer: text white 70%, highlighted fields orange-light-400, punctuation white 30%.
 *  - Editor: whole text block 70% opacity, highlighted fields white.
 */
interface Props { lines?: string[] }
// Each line: plain text, [[field]] = highlighted, ‹x› = punctuation (30% white)
const {
  lines = [
    'query MyQuery ‹{›',
    '  allProjects‹(›orderBy‹:› completedAt_DESC‹) {›',
    '    id',
    '    [[headline]]',
    '    [[subtitle]]',
    '    completedAt',
    '    [[client]] ‹{›',
    '      name',
    '    ‹}›',
    '    [[heroVideo]] ‹{›',
    '      video ‹{›',
    '        mp4Url',
    '        thumbnailUrl',
    '      ‹}›',
    '    ‹}›',
    '  ‹}›',
    '‹}›',
  ],
} = Astro.props;

const tokenise = (line: string) =>
  line.split(/(\[\[.*?\]\]|‹.*?›)/).filter(Boolean).map((part) => {
    if (part.startsWith('[[')) return { kind: 'hl', text: part.slice(2, -2) };
    if (part.startsWith('‹')) return { kind: 'punct', text: part.slice(1, -1) };
    return { kind: 'text', text: part };
  });
---
<div class="code-editor">
  <pre class="code-editor__code">{lines.map((line) => (
    <span class="code-editor__line">{tokenise(line).map((t) =>
      t.kind === 'text' ? t.text : <span class={`code-editor__${t.kind}`}>{t.text}</span>
    )}</span>
  ))}</pre>
</div>

<style>
  .code-editor {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-brown-deep-5);
    border-radius: 1.0258em;
    padding: 1.3677em;
  }
  .code-editor__code {
    margin: 0;
    font: 500 1em/1.5 var(--font-mono);
    color: color-mix(in srgb, var(--color-neutral-white) 70%, transparent);
    white-space: pre;
    transition: opacity var(--de-dur, 300ms) var(--de-ease, ease-out);
  }
  .code-editor__line { display: block; }
  .code-editor__punct { color: color-mix(in srgb, var(--color-neutral-white) 30%, transparent); }
  .code-editor__hl {
    color: var(--color-orange-light-5);
    transition: color var(--de-dur, 300ms) var(--de-ease, ease-out);
  }
  :global([data-focus='editor']) .code-editor__code { opacity: 0.7; }
  :global([data-focus='editor']) .code-editor__hl { color: var(--color-neutral-white); }
</style>
