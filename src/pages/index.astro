---
/**
 * DatoCMS homepage — Figma "Homepage — rebuilt with proposal components (not in use)" (3029:66055).
 * Section order and Theme modes follow the 1320 frame (3029:66056). Content is hard-coded.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import DeveloperEditorSection from '../components/sections/DeveloperEditorSection.astro';
import HeadlessCmsSection from '../components/sections/HeadlessCmsSection.astro';
import FeaturesMultiSection from '../components/sections/FeaturesMultiSection.astro';
import FeatureSection from '../components/sections/FeatureSection.astro';
import CardSection from '../components/sections/CardSection.astro';
import CommunitySection from '../components/sections/CommunitySection.astro';
import TextHeadlineCentered from '../components/sections/TextHeadlineCentered.astro';
import ProductUpdatesSection from '../components/sections/ProductUpdatesSection.astro';
import CaseStudiesSection from '../components/sections/CaseStudiesSection.astro';
import PartnersSection from '../components/sections/PartnersSection.astro';
import FooterAnimationSection from '../components/sections/FooterAnimationSection.astro';
import FooterLinks from '../components/sections/FooterLinks.astro';
import FooterLegal from '../components/sections/FooterLegal.astro';
---
<BaseLayout title="DatoCMS — Headless CMS" description="Bring your own AI. DatoCMS is the headless CMS developers and editors love.">
  <Header theme="orange" />
  <main>
    <Hero
      theme="orange"
      alignment="left"
      headline="Thoughtfully built and ambitiously used."
      subheadline="The AI-agnostic CMS that's human on support and transparent in pricing [••]"
      primaryButton={{ label: 'Get Started', href: '#', appearance: 'light-on-white' }}
      secondaryButton={{ label: 'Docs', href: '#', appearance: 'deep-on-white', variant: 'secondary' }}
      showLogos
      logoList="clients"
      typewriter
    />
    <DeveloperEditorSection />
    <HeadlessCmsSection />
    <FeaturesMultiSection />
    <FeatureSection theme="purple" />
    <CardSection />
    <CommunitySection />
    <TextHeadlineCentered
      theme="green"
      background="light"
      headline="Or join us on Slack."
      subline="Connect with +3000 developers using DATO CMS in production."
      showSubline
      primaryButton={{ label: 'Join Us On Slack', href: '#', arrow: true }}
    />
    <ProductUpdatesSection />
    <CaseStudiesSection />
    <PartnersSection />
    <TextHeadlineCentered
      theme="default"
      background="dark"
      headline="Pricing as it should be:"
      headlineMuted="Transparent and predictable"
      primaryButton={{ label: 'Explore Pricing', href: '#', arrow: true, variant: 'secondary' }}
    />
  </main>
  <footer>
    <FooterAnimationSection />
    <FooterLinks />
    <FooterLegal />
  </footer>
</BaseLayout>
